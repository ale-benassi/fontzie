{
  "name": "fontzie",
  "version": "1.0.4",
  "license": "MIT",
  "description": "Local-first typography playground for live websites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale-benassi/fontzie.git"
  },
  "bugs": {
    "url": "https://github.com/ale-benassi/fontzie/issues"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=local",
    "catalog:update": "node scripts/update-catalogs.mjs",
    "fonts:generate": "node scripts/generate-ui-fonts.mjs",
    "prepare": "wxt prepare",
    "prebuild": "node scripts/licenses.mjs",
    "prezip": "node scripts/licenses.mjs",
    "format": "prettier --write \"{background,components,composables,content,core,entrypoints,providers,storage,tests}/**/*.{ts,vue}\" \"*.ts\" \"scripts/update-catalogs.mjs\" \".github/workflows/*.yml\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"{background,components,composables,content,core,entrypoints,providers,storage,tests}/**/*.{ts,vue}\" \"*.ts\" \"scripts/update-catalogs.mjs\" \".github/workflows/*.yml\" \"eslint.config.mjs\"",
    "pretest:e2e": "npm run build",
    "test:providers": "npm run build && playwright test --project=providers",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "icons:generate": "node scripts/generate-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.1.32",
    "@types/fontkit": "2.0.8",
    "@types/node": "24.10.1",
    "@wxt-dev/module-vue": "1.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.2.6",
    "wxt": "0.21.4"
  },
  "private": true,
  "dependencies": {
    "@lucide/vue": "^1.58.0",
    "@vueuse/core": "^15.0.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fontkit": "2.0.4",
    "idb": "8.0.3",
    "reka-ui": "^2.11.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    }
  }
}
